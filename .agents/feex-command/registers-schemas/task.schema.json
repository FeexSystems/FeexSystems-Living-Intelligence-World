{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskAssignment",
  "type": "object",
  "required": ["taskId", "title", "assignee", "reviewer", "gate", "acceptanceChecks", "status"],
  "properties": {
    "taskId": { "type": "string", "pattern": "^T-[0-9]{4}$" },
    "title": { "type": "string" },
    "assignee": { "type": "string", "description": "Agent id, e.g. C3" },
    "reviewer": { "type": "string", "description": "Must differ from assignee" },
    "gate": { "type": "integer", "minimum": 0, "maximum": 6 },
    "dependsOn": { "type": "array", "items": { "type": "string" } },
    "ownedPaths": { "type": "array", "items": { "type": "string" } },
    "acceptanceChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "command"],
        "properties": {
          "description": { "type": "string" },
          "command": { "type": "string" }
        }
      }
    },
    "status": { "enum": ["PENDING", "IN_PROGRESS", "BLOCKED", "NEEDS_REVIEW", "DONE", "REJECTED"] },
    "evidenceIds": { "type": "array", "items": { "type": "string" } }
  }
}
