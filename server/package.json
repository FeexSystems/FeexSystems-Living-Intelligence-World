    "ioredis": "^5.3.2",
    "zod": "^3.22.4",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "openai": "^4.20.1",
    "axios": "^1.6.2",
    "ws": "^8.14.2",
    "node-cron": "^3.0.3",
