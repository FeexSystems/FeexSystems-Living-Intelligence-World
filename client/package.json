    "framer-motion": "^10.16.16",
    "lucide-react": "^0.303.0",
    "prismjs": "^1.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.18.3",
    "react-syntax-highlighter": "^15.5.0",
    "recharts": "^2.8.0",
    "remark-gfm": "^4.0.0",
