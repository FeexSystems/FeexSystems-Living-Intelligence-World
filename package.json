{
  "name": "feexsystems-living-intelligence-world",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x || 24.x",
    "npm": ">=10"
  },
  "type": "module",
  "main": "dist/server/node-build.mjs",
  "pkg": {
    "assets": [
      "dist/spa/*"
    ],
    "scripts": [
      "dist/server/**/*.js"
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "vite",
    "check:node": "node scripts/check-node.mjs",
    "pretest": "npm run check:node",
    "prepush": "npm run check:node && npm run typecheck",
    "setup:hooks": "git config core.hooksPath .githooks",
    "dc:compile": "firebase dataconnect:compile",
    "dc:emulator": "firebase emulators:start --only dataconnect",
    "dc:seed": "firebase dataconnect:execute dataconnect/seed_data.gql SeedWorldProjects",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --config vite.config.server.ts",
    "build:measure": "node scripts/measure-build.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/server/node-build.mjs",
    "test": "vitest --run",
    "test:unit": "vitest --run --project unit",
    "test:storybook": "vitest --run --project storybook",
    "test:all": "npm run test:unit && npm run test:storybook",
    "test:a11y": "vitest run client/test/a11y",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:pass10": "playwright test --config playwright.pass10.config.ts",
    "test:visual": "playwright test --grep @visual",
    "format.fix": "prettier --write .",
    "optimize:images": "node scripts/optimize-all-media.mjs",
    "typecheck": "tsc --incremental --project tsconfig.critical.json",
    "typecheck:server": "tsc --incremental --project tsconfig.server.json",
    "typecheck:client": "tsc --incremental --project tsconfig.client.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:client",
    "check:shadows": "node scripts/check-shadow-js.mjs",
    "size-limit": "size-limit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:init": "tsx scripts/migrate.ts init",
    "db:reset": "tsx scripts/migrate.ts reset",
    "db:seed": "tsx scripts/migrate.ts seed",
    "db:seed:auth": "tsx prisma/seed-auth.ts",
    "db:studio": "tsx scripts/migrate.ts studio",
    "db:status": "tsx scripts/migrate.ts status",
    "docker:dev": "docker-compose --profile dev up --build",
    "docker:prod": "docker-compose --profile prod up --build",
    "docker:down": "docker-compose down",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "validate": "tsx scripts/validate-setup.ts",
    "env:check": "node scripts/env-check.mjs",
    "deploy:firebase": "bash scripts/deploy-firebase.sh",
    "deploy:firebase:win": "powershell -ExecutionPolicy Bypass -File scripts/deploy-firebase.ps1",
    "deploy:supabase": "bash scripts/deploy-supabase-functions.sh",
    "deploy:supabase:win": "powershell -ExecutionPolicy Bypass -File scripts/deploy-supabase-functions.ps1",
    "docs:verify": "node scripts/verify-docs.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
