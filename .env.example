# ==============================================================================
# FEEXSYSTEMS — Living Engineering Intelligence (feexsystems.codes)
# Production & Local Environment Configuration
# ==============================================================================
#
# ⚠️ SECURITY WARNING ⚠️
# - This file contains templates only. NEVER commit real secrets.
# - Copy this file to .env and fill in your values.
# - .env is already in .gitignore - do not commit it.
# - For production, use GCP Secret Manager (see docs/SECRET-MANAGER-SETUP.md)
# - Rotate all secrets immediately if they are ever exposed
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN ROUTING
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=8080
BASE_URL="https://feexsystems.codes"
FRONTEND_URL="https://feexsystems.codes"

# ------------------------------------------------------------------------------
# 2. DATABASE & VECTOR EMBEDDINGS (Data Layer)
# ------------------------------------------------------------------------------
# PostgreSQL 15+ with pgvector extension
DATABASE_URL="postgresql://feex_admin:your-cloudsql-password@127.0.0.1:5432/feexsystems_production?schema=public"

# Redis for Bull background queue and session caching
REDIS_URL="redis://default:your-redis-password@127.0.0.1:6379"

# ------------------------------------------------------------------------------
# 3. AI MODEL LAYER (Provider-Neutral Routing)
# ------------------------------------------------------------------------------
# Google Gemini Enterprise / Google AI Studio (Primary model engine)
GEMINI_API_KEY="AIzaSy..."
GOOGLE_CLOUD_PROJECT="feexsystems-prod"

# Anthropic (Deep technical architecture & code analysis)
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI (Embeddings & fallback reasoning)
OPENAI_API_KEY="sk-..."

# Optional: Default provider ('gemini' | 'anthropic' | 'openai')
DEFAULT_AI_PROVIDER="gemini"

# ------------------------------------------------------------------------------
# 4. GITHUB INGESTION & EVIDENCE FABRIC
# ------------------------------------------------------------------------------
# GitHub Token for querying repositories, commits, and releases (PAT or App)
GITHUB_TOKEN="ghp_..."

# HMAC SHA-256 Secret for webhook payload verification (POST /api/world-model/webhook)
GITHUB_WEBHOOK_SECRET="feex-webhook-hmac-secret-..."

# OAuth for developer login via GitHub
GITHUB_CLIENT_ID="Iv1..."
GITHUB_CLIENT_SECRET="..."

# ------------------------------------------------------------------------------
# 5. SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# 256-bit Hex key (Generate using: openssl rand -hex 32)
# NOTE: Firebase Auth is the single source of truth for identity. This project
# no longer issues its own JWTs, so JWT_SECRET / JWT_REFRESH_SECRET / MOCK_JWT_*
# have been removed. Do not add them back.
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# ------------------------------------------------------------------------------
# MOCK AUTH (local development only)
#
# Leave USE_MOCK_AUTH unset/false in production. Firebase Auth remains the
# single source of truth for identity; this flag only gates local developer
# conveniences.
# ------------------------------------------------------------------------------
# USE_MOCK_AUTH="true"

BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=300

# ------------------------------------------------------------------------------
# 6. STORAGE & FILE UPLOADS
# ------------------------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760" # 10MB
# Cloud Storage bucket for ingested artifacts (Optional)
GCS_BUCKET_NAME="feexsystems-artifacts-prod"

# ------------------------------------------------------------------------------
# 7. FIREBASE & CLOUD CONSOLE INTEGRATION
# ------------------------------------------------------------------------------
# IMPORTANT: Firebase client keys (VITE_FIREBASE_*) are public but must match
# your Firebase project. Get them from Firebase Console → Project Settings.
# NEVER commit service account keys (firebase-service-account.json).
#
# Firebase Client Configuration (Public - OK to commit in templates):
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKey"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
#
# Firebase Admin Configuration (Private - Use GCP Secret Manager in production):
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
# For local development, use: gcloud auth application-default login
# For production, store in GCP Secret Manager as FIREBASE_SERVICE_ACCOUNT_KEY
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# ------------------------------------------------------------------------------
# 8. PAYSTACK PAYMENT GATEWAY & RECURRING SUBSCRIPTIONS
# ------------------------------------------------------------------------------
# IMPORTANT: Use TEST keys for development. NEVER commit live keys.
# Get test keys from: https://dashboard.paystack.co/#/settings/keys
#
# Development (Test Keys):
PAYSTACK_SECRET_KEY="sk_test_YOUR_PAYSTACK_TEST_SECRET_KEY"
PAYSTACK_PUBLIC_KEY="pk_test_YOUR_PAYSTACK_TEST_PUBLIC_KEY"
VITE_PAYSTACK_PUBLIC_KEY="pk_test_YOUR_PAYSTACK_TEST_PUBLIC_KEY"
#
# Production (Live Keys - Store in GCP Secret Manager):
# PAYSTACK_SECRET_KEY="sk_live_..."
# PAYSTACK_PUBLIC_KEY="pk_live_..."
# VITE_PAYSTACK_PUBLIC_KEY="pk_live_..."

# ------------------------------------------------------------------------------
# 9. SENTRY ERROR TRACKING (Required in Production)
# ------------------------------------------------------------------------------
SENTRY_DSN="https://...@sentry.io/..."

# ------------------------------------------------------------------------------
# 10. EMAIL & NOTIFICATIONS
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="no-reply@feexsystems.codes"

# ------------------------------------------------------------------------------
# 11. FEATURE FLAGS
# ------------------------------------------------------------------------------
ENABLE_ANALYTICS="true"
ENABLE_TELEMETRY="true"

# ------------------------------------------------------------------------------
# 12. INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Firebase Functions
FUNCTIONS_EMULATOR="false"
FUNCTION_TARGET=""

# Cloud Run
CLOUD_RUN_SERVICE_NAME="feexsystems-api"
CLOUD_RUN_REGION="us-central1"

# ------------------------------------------------------------------------------
# 13. DEBUGGING
# ------------------------------------------------------------------------------
# Set to 'true' to enable verbose logging
DEBUG="false"
