# ==============================================================================
# FEEXSYSTEMS — Living Engineering Intelligence (feexsystems.codes)
# Production & Local Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN ROUTING
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=8080
BASE_URL="https://feexsystems.codes"
FRONTEND_URL="https://feexsystems.codes"

# ------------------------------------------------------------------------------
# 2. DATABASE & VECTOR EMBEDDINGS (Data Layer)
# ------------------------------------------------------------------------------
# PostgreSQL 15+ with pgvector extension
DATABASE_URL="postgresql://feex_admin:your-cloudsql-password@127.0.0.1:5432/feexsystems_production?schema=public"

# Redis for Bull background queue and session caching
REDIS_URL="redis://default:your-redis-password@127.0.0.1:6379"

# ------------------------------------------------------------------------------
# 3. AI MODEL LAYER (Provider-Neutral Routing)
# ------------------------------------------------------------------------------
# Google Gemini Enterprise / Google AI Studio (Primary model engine)
GEMINI_API_KEY="AIzaSy..."
GOOGLE_CLOUD_PROJECT="feexsystems-prod"

# Anthropic (Deep technical architecture & code analysis)
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI (Embeddings & fallback reasoning)
OPENAI_API_KEY="sk-..."

# Optional: Default provider ('gemini' | 'anthropic' | 'openai')
DEFAULT_AI_PROVIDER="gemini"

# ------------------------------------------------------------------------------
# 4. GITHUB INGESTION & EVIDENCE FABRIC
# ------------------------------------------------------------------------------
# GitHub Token for querying repositories, commits, and releases (PAT or App)
GITHUB_TOKEN="ghp_..."

# HMAC SHA-256 Secret for webhook payload verification (POST /api/world-model/webhook)
GITHUB_WEBHOOK_SECRET="feex-webhook-hmac-secret-..."

# OAuth for developer login via GitHub
GITHUB_CLIENT_ID="Iv1..."
GITHUB_CLIENT_SECRET="..."

# ------------------------------------------------------------------------------
# 5. SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# 256-bit Hex keys (Generate using: openssl rand -hex 32)
JWT_SECRET="generate-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="generate-with-openssl-rand-hex-32"
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# ------------------------------------------------------------------------------
# MOCK AUTH (local development only)
#
# Leave USE_MOCK_AUTH unset/false in production. When true, the two secrets
# below are REQUIRED and must be different from JWT_SECRET/JWT_REFRESH_SECRET:
# mock tokens are signed with them and the auth middleware will accept them.
# ------------------------------------------------------------------------------
# USE_MOCK_AUTH="true"
# MOCK_JWT_SECRET="generate-with-openssl-rand-hex-32"
# MOCK_JWT_REFRESH_SECRET="generate-with-openssl-rand-hex-32"

JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=300

# ------------------------------------------------------------------------------
# 6. STORAGE & FILE UPLOADS
# ------------------------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760" # 10MB
# Cloud Storage bucket for ingested artifacts (Optional)
GCS_BUCKET_NAME="feexsystems-artifacts-prod"

# ------------------------------------------------------------------------------
# 7. FIREBASE & CLOUD CONSOLE INTEGRATION
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="feexsystems-codes"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@feexsystems-codes.iam.gserviceaccount.com"
# Path to service account JSON (or inline JSON in production secrets)
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ------------------------------------------------------------------------------
# 8. PAYSTACK PAYMENT GATEWAY & RECURRING SUBSCRIPTIONS
# ------------------------------------------------------------------------------
# Paystack Live / Test Secret Key (Server-only)
PAYSTACK_SECRET_KEY="sk_live_..."

# Paystack Live / Test Public Key (Client & Server)
PAYSTACK_PUBLIC_KEY="pk_live_..."
VITE_PAYSTACK_PUBLIC_KEY="pk_live_..."

# ------------------------------------------------------------------------------
# 9. SENTRY ERROR TRACKING (Required in Production)
# ------------------------------------------------------------------------------
SENTRY_DSN="https://...@sentry.io/..."

# ------------------------------------------------------------------------------
# 10. EMAIL & NOTIFICATIONS
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="no-reply@feexsystems.codes"

# ------------------------------------------------------------------------------
# 11. FEATURE FLAGS
# ------------------------------------------------------------------------------
ENABLE_ANALYTICS="true"
ENABLE_TELEMETRY="true"

# ------------------------------------------------------------------------------
# 12. INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Firebase Functions
FUNCTIONS_EMULATOR="false"
FUNCTION_TARGET=""

# Cloud Run
CLOUD_RUN_SERVICE_NAME="feexsystems-api"
CLOUD_RUN_REGION="us-central1"

# ------------------------------------------------------------------------------
# 13. DEBUGGING
# ------------------------------------------------------------------------------
# Set to 'true' to enable verbose logging
DEBUG="false"
