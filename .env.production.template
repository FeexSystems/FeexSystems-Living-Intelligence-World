# ==============================================================================
# FeexSystems Enterprise Production Environment Configuration Template
# Target: Google Cloud Run + Cloud SQL + Memorystore + Firebase + BigQuery + GCS
# ==============================================================================

# Core Runtime
NODE_ENV=production
APP_PORT=8080
APP_URL=https://feexsystems.codes
CORS_ORIGIN=https://feexsystems.codes

# Database (Cloud SQL - PostgreSQL 15 via Private IP or Cloud SQL Auth Proxy)
DATABASE_URL=postgresql://feexsystems:YOUR_DB_PASSWORD@10.x.x.x:5432/feexsystems_db?schema=public&sslmode=prefer

# Cache & Message Queues (Google Cloud Memorystore Redis)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@10.y.y.y:6379

# Google Cloud Platform Identity & Services
GCP_REGION=us-central1
GCS_EVIDENCE_BUCKET=feexsystems-evidence-artifacts
BIGQUERY_DATASET=feexsystems_analytics

# Google Gemini API (Provider-Neutral Reasoning & Multimodal Analysis)
GEMINI_API_KEY=AIzaSyYourProductionGeminiApiKey

# GitHub Integration & Evidence Fabric Ingestion
GITHUB_ORG=FeexSystems
GITHUB_ACCESS_TOKEN=ghp_YourProductionGitHubPersonalAccessToken
GITHUB_WEBHOOK_SECRET=YourProductionWebhookHmacSha256Secret

# Firebase Client & Remote Config (Public Client-Side Keys)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKey
VITE_FIREBASE_AUTH_DOMAIN=feexsystems-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=feexsystems-prod
VITE_FIREBASE_STORAGE_BUCKET=feexsystems-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase Admin Service Account (JSON payload for backend token verification)
# Stored in GCP Secret Manager as FIREBASE_SERVICE_ACCOUNT_KEY
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"feexsystems-prod",...}

# Security & Session Authentication
JWT_SECRET=your_high_entropy_256bit_production_jwt_signing_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_high_entropy_256bit_production_refresh_secret_here_min_32_chars
ENCRYPTION_KEY=your_high_entropy_256bit_production_encryption_key_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=your_high_entropy_cookie_signing_secret_here

# Error Monitoring & Observability
SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/7654321
