// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id
  email            String    @unique
  passwordHash     String    @map("password_hash")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  profileImageUrl  String?   @map("profile_image_url")
  role             UserRole  @default(USER)
  emailVerified    Boolean   @default(false) @map("email_verified")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  lastLoginAt      DateTime? @map("last_login_at")

  // Relations
  sessions      Session[]
  refreshTokens RefreshToken[]
  subscriptions Subscription[]
  aiRequests    AIRequest[]
  repositories          Repository[]
  securityScans         SecurityScan[]
  recurringSecurityScans RecurringSecurityScan[]
  teamMembers           TeamMember[]
  usageMetrics  UsageMetrics[]
  activityLogs  ActivityLog[]
  userEvents   UserEvent[]

  @@map("users")
}

enum EventType {
  session_start
  session_end
  feature_used
  error
  conversion
  subscription_changed
}

model UserEvent {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  eventType EventType @map("event_type")
  eventData Json      @default("{}") @map("event_data")
  timestamp DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventType])
  @@index([timestamp])
  @@map("user_events")
}

model AnalyticsMetric {
  id          String   @id @default(cuid())
  metricName  String   @map("metric_name")
  metricValue Float    @map("metric_value")
  dimensions  Json     @default("{}")
  timestamp   DateTime @default(now())

  @@index([metricName])
  @@index([timestamp])
  @@map("analytics_metrics")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Plan {
  id                String   @id @default(cuid())
  name              String
  description       String?
  price             Int      // Price in cents
  currency          String   @default("usd")
  interval          String   // 'month' or 'year'
  intervalCount     Int      @default(1) @map("interval_count")
  trialPeriodDays   Int?     @map("trial_period_days")
  features          Json     // JSON object with feature limits
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String            @id @default(cuid())
  userId               String            @map("user_id")
  planId               String            @map("plan_id")
  status               SubscriptionStatus
  currentPeriodStart   DateTime          @map("current_period_start")
  currentPeriodEnd     DateTime          @map("current_period_end")
  cancelAtPeriodEnd    Boolean           @default(false) @map("cancel_at_period_end")
  trialStart           DateTime?         @map("trial_start")
  trialEnd             DateTime?         @map("trial_end")
  canceledAt           DateTime?         @map("canceled_at")
  endedAt              DateTime?         @map("ended_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model AIRequest {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  serviceId      String        @map("service_id")
  inputData      Json          @map("input_data")
  outputData     Json?         @map("output_data")
  metadata       Json?
  status         RequestStatus @default(PENDING)
  processingTime Int?          @map("processing_time")
  tokensUsed     Int?          @map("tokens_used")
  createdAt      DateTime      @default(now()) @map("created_at")
  completedAt    DateTime?     @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_requests")
}

model Repository {
  id                   String       @id @default(cuid())
  userId               String       @map("user_id")
  provider             GitProvider
  repoUrl              String       @map("repo_url")
  branch               String       @default("main")
  accessTokenEncrypted String?      @map("access_token_encrypted")
  webhookUrl           String?      @map("webhook_url")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pipelines   Pipeline[]
  deployments Deployment[]
  marketingProducts MarketingProduct[]

  @@map("repositories")
}

model Pipeline {
  id           String          @id @default(cuid())
  repositoryId String          @map("repository_id")
  name         String
  stages       Json
  triggers     Json
  environment  Json
  status       PipelineStatus  @default(ACTIVE)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  repository  Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@map("pipelines")
}

model Deployment {
  id           String           @id @default(cuid())
  repositoryId String           @map("repository_id")
  pipelineId   String?          @map("pipeline_id")
  commit       String
  status       DeploymentStatus @default(PENDING)
  logs         Json?
  startedAt    DateTime         @default(now()) @map("started_at")
  completedAt  DateTime?        @map("completed_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  pipeline   Pipeline?  @relation(fields: [pipelineId], references: [id], onDelete: SetNull)

  @@map("deployments")
}

model SecurityScan {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  targetData  Json           @map("target_data")
  scanType    SecurityScanType @map("scan_type")
  status      ScanStatus     @default(QUEUED)
  results     Json?
  scheduledAt DateTime?      @map("scheduled_at")
  startedAt   DateTime?      @map("started_at")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("security_scans")
}

model RecurringSecurityScan {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  targetData     Json             @map("target_data")
  scanType       SecurityScanType @map("scan_type")
  cronExpression String           @map("cron_expression")
  configuration  Json?
  isActive       Boolean          @default(true) @map("is_active")
  lastRunAt      DateTime?        @map("last_run_at")
  nextRunAt      DateTime?        @map("next_run_at")
  runCount       Int              @default(0) @map("run_count")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recurring_security_scans")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String   @map("owner_id")
  settings    Json?    // Team-wide settings and preferences
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members         TeamMember[]
  workspaces      Workspace[]
  invitations     TeamInvitation[]
  resourceShares  ResourceShare[]
  activityLogs    TeamActivityLog[]

  @@map("teams")
}

model TeamMember {
  id          String     @id @default(cuid())
  teamId      String     @map("team_id")
  userId      String     @map("user_id")
  role        TeamRole   @default(MEMBER)
  permissions Json?      // Additional granular permissions
  status      MemberStatus @default(ACTIVE)
  joinedAt    DateTime   @default(now()) @map("joined_at")
  invitedBy   String?    @map("invited_by")
  lastActiveAt DateTime? @map("last_active_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamInvitation {
  id          String           @id @default(cuid())
  teamId      String           @map("team_id")
  email       String
  role        TeamRole         @default(MEMBER)
  permissions Json?            // Additional granular permissions
  status      InvitationStatus @default(PENDING)
  token       String           @unique
  invitedBy   String           @map("invited_by")
  expiresAt   DateTime         @map("expires_at")
  acceptedAt  DateTime?        @map("accepted_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@map("team_invitations")
}

model Workspace {
  id          String   @id @default(cuid())
  teamId      String   @map("team_id")
  name        String
  description String?
  settings    Json?    // Workspace-specific settings
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  resourceShares ResourceShare[]

  @@map("workspaces")
}

model ResourceShare {
  id           String       @id @default(cuid())
  teamId       String       @map("team_id")
  workspaceId  String?      @map("workspace_id")
  resourceType ResourceType @map("resource_type")
  resourceId   String       @map("resource_id")
  permissions  Json         // Specific permissions for this resource
  sharedBy     String       @map("shared_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([teamId, resourceType, resourceId])
  @@map("resource_shares")
}

model TeamActivityLog {
  id         String   @id @default(cuid())
  teamId     String   @map("team_id")
  userId     String   @map("user_id")
  action     String
  resource   String
  resourceId String   @map("resource_id")
  metadata   Json?
  timestamp  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, timestamp])
  @@index([action])
  @@index([resource])
  @@map("team_activity_logs")
}

model UsageMetrics {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  period            String
  aiRequestsCount   Int      @default(0) @map("ai_requests_count")
  deploymentCount   Int      @default(0) @map("deployment_count")
  securityScansCount Int     @default(0) @map("security_scans_count")
  storageUsed       BigInt   @default(0) @map("storage_used")
  bandwidthUsed     BigInt   @default(0) @map("bandwidth_used")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@map("usage_metrics")
}


model ActivityLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  action     String
  resource   String
  resourceId String   @map("resource_id")
  metadata   Json?
  timestamp  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([action])
  @@index([resource])
  @@map("activity_logs")
}

// Enums
enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAST_DUE
  TRIALING
  UNPAID
  PAUSED
}

enum RequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum GitProvider {
  GITHUB
  GITLAB
  BITBUCKET
}

enum PipelineStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum DeploymentStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELED
}

enum SecurityScanType {
  VULNERABILITY
  PENETRATION
  COMPLIANCE
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ResourceType {
  AI_REQUEST
  REPOSITORY
  PIPELINE
  DEPLOYMENT
  SECURITY_SCAN
  WORKSPACE
}

// ==========================================
// FEEXSYSTEMS Living World Model Entities
// ==========================================

model WorldModelProject {
  id              String   @id
  repository      String   @unique
  name            String
  owner           String
  url             String
  description     String?
  visibility      String?
  isPinned        Boolean  @default(false) @map("is_pinned")
  source          String   @default("github")
  metadata        Json     @default("{}")
  repoId          BigInt?  @map("repo_id")
  firstObservedAt DateTime @default(now()) @map("first_observed_at")
  lastObservedAt  DateTime @default(now()) @map("last_observed_at")

  evidence        WorldModelEvidence[]
  artifacts       WorldModelArtifact[]
  events          WorldModelEvent[]

  @@index([isPinned])
  @@map("world_model_projects")
  marketingProducts MarketingProduct[]
  marketingEvents   MarketingEvent[]
}

model WorldModelEvidence {
  id           String   @id
  projectId    String   @map("project_id")
  evidenceType String   @map("evidence_type")
  sourceUrl    String   @map("source_url")
  sourceRef    String?  @map("source_ref")
  metadata     Json     @default("{}")
  observedAt   DateTime @default(now()) @map("observed_at")

  project      WorldModelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("world_model_evidence")
  claimLinks   MarketingClaimEvidence[]
}

model WorldModelArtifact {
  id        String   @id
  projectId String   @map("project_id")
  path      String
  sha       String
  kind      String
  size      BigInt?
  metadata  Json     @default("{}")
  updatedAt DateTime @default(now()) @map("updated_at")

  project   WorldModelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
  @@map("world_model_artifacts")
}

model WorldModelTechnology {
  id       String @id
  name     String @unique
  category String?
  metadata Json   @default("{}")

  @@map("world_model_technologies")
  marketingFeatures MarketingFeature[]
}

model WorldModelRelationship {
  id       String @id
  sourceId String @map("source_id")
  targetId String @map("target_id")
  relation String
  metadata Json   @default("{}")

  @@unique([sourceId, targetId, relation])
  @@map("world_model_relationships")
}

model WorldModelEvent {
  id           String   @id
  projectId    String?  @map("project_id")
  eventType    String   @map("event_type")
  commitSha    String?  @map("commit_sha")
  changedPaths Json     @default("[]") @map("changed_paths")
  payload      Json     @default("{}")
  occurredAt   DateTime @default(now()) @map("occurred_at")

  project      WorldModelProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, occurredAt(sort: Desc)])
  @@map("world_model_events")
}



// ==========================================
// Phase 1: Marketing Models
// ==========================================

enum ContentLifecycleState {
  IDEA
  RESEARCH
  BRIEF
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MarketingChannelType {
  WEBSITE
  SOCIAL
  EMAIL
  OTHER
}

model MarketingProduct {
  id                  String   @id @default(cuid())
  worldModelProjectId String?  @map("world_model_project_id")
  repositoryId        String?  @map("repository_id")
  name                String
  description         String?

  worldModelProject   WorldModelProject? @relation(fields: [worldModelProjectId], references: [id], onDelete: Cascade)
  repository          Repository?        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  features            MarketingFeature[]
  claims              MarketingClaim[]
  events              MarketingEvent[]
  audiences           MarketingAudience[]
  campaigns           MarketingCampaignProduct[]

  @@map("marketing_products")
}

model MarketingFeature {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  technologyId   String?  @map("technology_id")
  name           String
  description    String?

  product        MarketingProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  technology     WorldModelTechnology? @relation(fields: [technologyId], references: [id], onDelete: SetNull)

  aboutLinks     MarketingClaimAbout[]

  @@map("marketing_features")
}

model MarketingTopic {
  id   String @id @default(cuid())
  name String @unique

  assets MarketingContentAssetTopic[]

  @@map("marketing_topics")
}

model MarketingContentAsset {
  id        String                @id @default(cuid())
  parentId  String?               @map("parent_id")
  title     String
  type      String
  state     ContentLifecycleState @default(DRAFT)
  content   String?               @db.Text

  parent    MarketingContentAsset?  @relation("AssetLineage", fields: [parentId], references: [id], onDelete: SetNull)
  children  MarketingContentAsset[] @relation("AssetLineage")

  topics    MarketingContentAssetTopic[]
  events    MarketingEvent[]

  @@map("marketing_content_assets")
}

model MarketingContentAssetTopic {
  assetId String @map("asset_id")
  topicId String @map("topic_id")

  asset MarketingContentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  topic MarketingTopic        @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([assetId, topicId])
  @@map("marketing_content_asset_topics")
}

model MarketingCampaign {
  id          String   @id @default(cuid())
  name        String
  description String?

  products    MarketingCampaignProduct[]
  events      MarketingEvent[]
  experiments MarketingExperiment[]

  @@map("marketing_campaigns")
}

model MarketingCampaignProduct {
  campaignId String @map("campaign_id")
  productId  String @map("product_id")

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  MarketingProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@map("marketing_campaign_products")
}

model MarketingAudience {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  name        String
  description String?

  product     MarketingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("marketing_audiences")
}

model MarketingChannel {
  id          String               @id @default(cuid())
  name        String
  type        MarketingChannelType
  description String?

  events      MarketingEvent[]

  @@map("marketing_channels")
}

model MarketingClaim {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  statement   String
  isVerified  Boolean  @default(false) @map("is_verified")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product     MarketingProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)

  evidence    MarketingClaimEvidence[]
  aboutLinks  MarketingClaimAbout[]
  auditLogs   MarketingClaimAudit[]

  @@map("marketing_claims")
}

model MarketingClaimEvidence {
  id                   String  @id @default(cuid())
  claimId              String  @map("claim_id")
  worldModelEvidenceId String? @map("world_model_evidence_id")
  marketingEvidenceId  String? @map("marketing_evidence_id")

  claim              MarketingClaim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  worldModelEvidence WorldModelEvidence? @relation(fields: [worldModelEvidenceId], references: [id], onDelete: Cascade)
  marketingEvidence  MarketingEvidence?  @relation(fields: [marketingEvidenceId], references: [id], onDelete: Cascade)

  @@map("marketing_claim_evidence")
}

model MarketingEvidence {
  id          String   @id @default(cuid())
  sourceUrl   String   @map("source_url")
  description String?
  observedAt  DateTime @default(now()) @map("observed_at")

  claimLinks  MarketingClaimEvidence[]

  @@map("marketing_evidence")
}

model MarketingEvent {
  id                  String   @id @default(cuid())
  worldModelProjectId String?  @map("world_model_project_id")
  productId           String?  @map("product_id")
  assetId             String?  @map("asset_id")
  campaignId          String?  @map("campaign_id")
  channelId           String?  @map("channel_id")
  eventType           String   @map("event_type")
  occurredAt          DateTime @default(now()) @map("occurred_at")
  metadata            Json     @default("{}")

  worldModelProject   WorldModelProject?     @relation(fields: [worldModelProjectId], references: [id], onDelete: Cascade)
  product             MarketingProduct?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset               MarketingContentAsset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  campaign            MarketingCampaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel             MarketingChannel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("marketing_events")
}

// ==========================================
// Phase 2: Marketing Claim Graph Extensions
// ==========================================

model MarketingClaimAbout {
  id           String  @id @default(cuid())
  claimId      String  @map("claim_id")
  featureId    String? @map("feature_id")
  technologyId String? @map("technology_id") 

  claim      MarketingClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  feature    MarketingFeature? @relation(fields: [featureId], references: [id], onDelete: Cascade)
  
  @@map("marketing_claim_about")
}

model MarketingClaimAudit {
  id         String   @id @default(cuid())
  claimId    String   @map("claim_id")
  action     String   // e.g. "claim_created", "evidence_propagated"
  metadata   Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at")

  claim      MarketingClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, occurredAt(sort: Desc)])
  @@map("marketing_claim_audit")
}

// ==========================================
// Phase 9: Campaign Experimentation
// ==========================================

model MarketingExperiment {
  id          String    @id @default(cuid())
  campaignId  String    @map("campaign_id")
  hypothesis  String
  status      String    @default("PLANNED")
  decision    String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  campaign    MarketingCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variants    MarketingExperimentVariant[]

  @@map("marketing_experiments")
}

model MarketingExperimentVariant {
  id            String   @id @default(cuid())
  experimentId  String   @map("experiment_id")
  name          String
  configuration Json     @default("{}")

  experiment    MarketingExperiment    @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  observations  MarketingObservation[]

  @@map("marketing_experiment_variants")
}

model MarketingObservation {
  id         String   @id @default(cuid())
  variantId  String   @map("variant_id")
  metric     String   // e.g., "QIE", "CLICK"
  value      Float
  metadata   Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at")

  variant    MarketingExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, metric, occurredAt(sort: Desc)])
  @@map("marketing_observations")
}
